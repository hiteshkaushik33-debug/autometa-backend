{
  "name": "autometa",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "api",
    "worker",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev:web": "npm --prefix ../users run dev",
    "dev:api": "tsx watch api/src/main.ts",
    "dev:worker": "tsx watch worker/src/main.ts",
    "build": "npm run db:generate && tsc -p tsconfig.services.json",
    "typecheck": "tsc --noEmit -p tsconfig.services.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/smoke.ts",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:dev": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "dev:inbox": "tsx scripts/dev-inbox.ts",
    "test:accounts": "tsx scripts/accounts.e2e.ts",
    "dev:configure": "tsx scripts/configure-local.ts",
    "smtp:verify": "tsx scripts/smtp-check.ts",
    "smtp:test": "tsx scripts/smtp-check.ts send",
    "test:email": "tsx scripts/email.e2e.ts",
    "test:email:live": "tsx scripts/email.e2e.ts --live",
    "test:email-worker": "tsx scripts/email-worker.e2e.ts",
    "test:follow-up": "tsx scripts/follow-up.e2e.ts",
    "test:billing": "tsx scripts/billing.e2e.ts",
    "dev:webhooks": "tsx scripts/webhook-proxy.ts",
    "start:api": "node dist/api/src/main.js",
    "start:worker": "node dist/worker/src/main.js",
    "ops:configure": "tsx scripts/configure-ops.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.63.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
